# Copy to .env and load with: set -a; source .env; set +a
CHAT_ADAPTER=console            # console | teams
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1           # must support tool calling

# MS Teams (CHAT_ADAPTER=teams) - values from the Azure Bot / Entra app registration
TEAMS_APP_ID=
TEAMS_APP_SECRET=
TEAMS_TENANT_ID=
TEAMS_SERVICE_URL=https://smba.trafficmanager.net/emea/   # fallback for proactive posts to the team channel
PORT=3978                       # Azure Bot messaging endpoint: https://<public-host>/api/messages
TEAM_CHAT_ID=                   # Teams conversation id of the team channel (get it with /id)

# Comma separated user ids (Teams: Entra object id, get it with /id; "console" for the console adapter)
ALLOWED_USERS=                  # empty = everyone may chat
ADMINS=                         # may trigger dangerous tools (after confirming)

# VM tools
VM_HOSTS=ops@vm1.internal,ops@vm2.internal
CREATE_VM_SCRIPT=/opt/chatbot/create_vm.sh
